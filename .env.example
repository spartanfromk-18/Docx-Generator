# ===== SpecForge environment =====
# Copy to .env and adjust. Every value has a working dev default.

# --- API server ---
PORT=8787
CORS_ORIGIN=http://localhost:5173

# --- Database ---
# true  = zero-setup in-memory store (survives until restart; great for demos/CI)
# false = PostgreSQL. On boot the server applies scripts/init_db.sql if the schema
#         is missing, then connects as the app_api / app_system roles per the TRD.
USE_MEMORY_DB=true
DATABASE_URL=postgresql://specforge:specforge_pwd@localhost:5432/specforge
# Passwords assigned to the app_api / app_system roles during bootstrap (dev only)
DB_ROLE_PASSWORD_API=app_api_dev
DB_ROLE_PASSWORD_SYSTEM=app_system_dev

# --- Auth ---
JWT_SECRET=dev-only-change-me

# --- LLM providers ---
# Provider order tried by the gateway. "mock" is a deterministic offline generator,
# so the full pipeline works with no API keys. Add real providers by putting them
# first and setting their key.
LLM_PROVIDER_ORDER=mock,anthropic,openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Pipeline demo controls ---
# Streaming delay multiplier for the mock provider (0 = instant, 1 = realistic pacing)
SPECFORGE_MOCK_SPEED=1
# Set to "provider_outage" to demo the paused_provider circuit-breaker state
SPECFORGE_FAULTS=

# --- Stripe (mock in dev) ---
STRIPE_WEBHOOK_SECRET=
